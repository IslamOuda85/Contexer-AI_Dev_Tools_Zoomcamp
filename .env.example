# Copy to .env for local development and replace placeholders. Never commit .env.
# Keep this file free of real credentials.
OPENAI_API_KEY=replace-with-your-server-side-key

# Supabase local values are printed by `npx supabase status` after `npx supabase start`.
# The publishable/anon key may be used by the browser; the service-role key must stay server-side.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_PUBLISHABLE_KEY=replace-with-local-publishable-key
